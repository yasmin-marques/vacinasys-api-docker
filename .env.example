APP_NAME=VacinaSys

# ===================== MongoDB =====================
# Deixe ativa apenas UMA das linhas MONGODB_URL.

# Docker (padrão) — nome do serviço do docker-compose
MONGODB_URL=mongodb://mongo:27017

# Desenvolvimento local (API fora do Docker)
# MONGODB_URL=mongodb://localhost:27017

# MongoDB Atlas (nuvem)
# MONGODB_URL=mongodb+srv://usuario:senha@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority

MONGODB_DATABASE=vacinasys

# ===================== MinIO ======================
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=documents
MINIO_SECURE=False

# Credenciais do serviço minio no docker-compose
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin